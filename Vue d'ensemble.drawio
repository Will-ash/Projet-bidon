        <mxCell id="qhNH78t8y1Q_wre_9ulW-1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" value="&lt;div&gt;&lt;u&gt;Conditions d&#39;application de la méthode BEST&lt;/u&gt; :&lt;/div&gt;&lt;div&gt;- sol isotrope homogène, dont le profil hydrique initial est homogène&lt;/div&gt;&lt;div&gt;- humidité initiale &amp;lt; 0,25 de l&#39;humidité à saturation&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="380" x="1210" y="-150" as="geometry" />
        </mxCell>
        <mxCell id="qhNH78t8y1Q_wre_9ulW-2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" value="&lt;div&gt;&lt;u&gt;Application aux sols ayant une croute de battance en surface :&lt;/u&gt;&lt;/div&gt;&lt;div&gt;&lt;u&gt;&lt;br&gt;&lt;/u&gt;&lt;/div&gt;&lt;div&gt;BEST reste utilisable, mais il faut faire attention à l&#39;interprétation du Ksat qui est effectuée&lt;/div&gt;&lt;div&gt;En effet, les paramètres hydrodynamiques estimés seront d&#39;avantage représentatif de la zone explorée durant l&#39;infiltration que de la croute en surface&lt;/div&gt;&lt;div&gt;La conductivité estimée est donc une conductivité effective et non une propriétés intrasec à une couche de sol&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="380" x="990" y="-20" as="geometry" />
        </mxCell>
        <mxCell id="qhNH78t8y1Q_wre_9ulW-3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" value="&lt;div&gt;&lt;u&gt;Application aux sols très humide :&lt;/u&gt;&lt;/div&gt;&lt;div&gt;&lt;u&gt;&lt;br&gt;&lt;/u&gt;&lt;/div&gt;&lt;div&gt;Les paramètres&amp;nbsp;β et&amp;nbsp;γ ne seront plus valide&lt;/div&gt;&lt;div&gt;Leur validité sera en plus compromise si on est en présence d&#39;un sol complexe avec des écoulements préférentiels&lt;/div&gt;&lt;div&gt;Recalibrer les paramètres&amp;nbsp;β et&amp;nbsp;γ est d&#39;avantage du domaine de la recherche que de l&#39;application. Il n&#39;existe pas de consensus pour recalibrer ces paramètres&lt;/div&gt;&lt;div&gt;Effectuer un test sur un sol humide va d&#39;avantage rendre l&#39;estimation de la sorptivité incertaine et créer un biais dans l&#39;estimation du Ksat&lt;/div&gt;" vertex="1">
          <mxGeometry height="160" width="380" x="1410" y="-20" as="geometry" />
        </mxCell>
