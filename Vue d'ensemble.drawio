        <mxCell id="zmcwH1kLG_5Q-xYCPw8v-14" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=#6c8ebf;fillColor=#dae8fc;align=center;verticalAlign=middle;rounded=0;" value="Humidité résiduelle&amp;nbsp;θr peut être approchée comme étant égale à 0" vertex="1">
