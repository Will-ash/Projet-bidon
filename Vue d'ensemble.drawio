        <mxCell id="n8ZXuJxr7fLm-53ztS49-45" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=#d79b00;fillColor=#ffe6cc;align=center;verticalAlign=middle;rounded=0;" value="&lt;div&gt;&lt;span style=&quot;color: rgb(255, 0, 0);&quot;&gt;Ksat&lt;/span&gt;&lt;/div&gt;&lt;div&gt;calculé en optimisant le fitting et en vérifiant que le modèle est bien applicable (uniquement en condition transitoire)&lt;/div&gt;&lt;div&gt;Ksat = q+&lt;span class=&quot;mwe-math-element mwe-math-element-inline&quot; id=&quot;mwEw&quot;&gt;&lt;img src=&quot;https://wikimedia.org/api/rest_v1/media/math/render/svg/c26c105004f30c27aa7c2a9c601550a4183b1f21&quot; class=&quot;mwe-math-fallback-image-inline mw-invert skin-invert&quot; aria-hidden=&quot;true&quot; style=&quot;vertical-align: -0.338ex; width:2.324ex; height:1.676ex;&quot; alt=&quot;{\displaystyle \infty }&quot;&gt;&amp;nbsp;* AS&lt;sup&gt;2&lt;/sup&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
