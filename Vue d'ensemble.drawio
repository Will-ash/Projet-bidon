        <mxCell id="n8ZXuJxr7fLm-53ztS49-41" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Modèle de Haverkamp, adapté pour BEST avec q+&lt;span class=&quot;mwe-math-element mwe-math-element-inline&quot; id=&quot;mwEw&quot;&gt;&lt;span class=&quot;mwe-math-mathml-a11y&quot; style=&quot;display: none;&quot;&gt;&lt;math xmlns=&quot;http://www.w3.org/1998/Math/MathML&quot;&gt;&lt;br/&gt;  &lt;br/&gt;    &lt;mrow&gt;&lt;br/&gt;      &lt;mstyle displaystyle=&quot;true&quot; scriptlevel=&quot;0&quot;&gt;&lt;br/&gt;        &lt;mi mathvariant=&quot;normal&quot;&gt;∞&lt;/mi&gt;&lt;br/&gt;      &lt;/mstyle&gt;&lt;br/&gt;    &lt;/mrow&gt;&lt;br/&gt;    &lt;br/&gt;  &lt;br/&gt;&lt;/math&gt;&lt;/span&gt;&lt;img src=&quot;https://wikimedia.org/api/rest_v1/media/math/render/svg/c26c105004f30c27aa7c2a9c601550a4183b1f21&quot; class=&quot;mwe-math-fallback-image-inline mw-invert skin-invert&quot; aria-hidden=&quot;true&quot; style=&quot;vertical-align: -0.338ex; width:2.324ex; height:1.676ex;&quot; alt=&quot;{\displaystyle \infty }&quot;&gt;&amp;nbsp;= flux d&#39;infiltration, considéré comme constant&lt;/span&gt;" vertex="1">
