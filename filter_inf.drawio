        <mxCell id="1e4iKTJRiBa4m_NirfYj-18" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#2A21FF;" value="En théorie, l&#39;anneau est enfoncé à 2 cm de profondeur et le bas de infiltromètre est positionné à 1-2 cm du sol. cela correspond à un volume initiale entre 177 et 353 cm3" vertex="1">
          <mxGeometry height="80" width="240" x="1030" y="145" as="geometry" />
        </mxCell>
        <mxCell id="1e4iKTJRiBa4m_NirfYj-19" parent="1" style="ellipse;whiteSpace=wrap;html=1;shapeInside=1;aspect=fixed;strokeColor=#5B965D;" value="3" vertex="1">
